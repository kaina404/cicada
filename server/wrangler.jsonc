// The website and the share service in one Worker on cicada.indaloop.app. The static site
// (scripts/site.py → build/site) is served as assets; only /s/* and /api/* run the Worker.
// scripts/share-setup.sh creates the D1 database and the R2 bucket once and fills in database_id.
{
  "name": "cicada-site",
  "main": "src/index.js",
  // Not newer than the local runtime the installed wrangler ships (wrangler dev refuses it).
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "../build/site",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/s/*", "/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "cicada-share", "database_id": "1fa377d0-ec6a-49cc-b1f5-45b9681aa36e", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "cicada-share" }],
  "durable_objects": { "bindings": [{ "name": "GATE", "class_name": "Gate" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Gate"] }],
  "triggers": { "crons": ["17 3 * * *"] },
  "vars": { "REVIEW_MODELS": "cloudflare/clef-flash,typesafe/jev-1.14", "SHARING": "on", "MIN_CLIENT": "0.0.0" },
  "observability": { "enabled": true }
}
