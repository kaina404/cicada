<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unit tests for the pure parts, as a plain console runner: no test framework packages. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Cicada.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../../Resources/**/Localizable.strings*" LinkBase="Resources" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/Cicada/Strings/**/Windows.strings" LinkBase="Resources" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures/**" CopyToOutputDirectory="PreserveNewest" />
    <!-- The share document contract, shared with the Mac and the server (Tests/fixtures/share). -->
    <None Include="../../../Tests/fixtures/share/**" LinkBase="Fixtures/share" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="../../src/Cicada.Core/Cicada.Core.csproj" />
  </ItemGroup>
</Project>
