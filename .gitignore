# Build output
.build/
build/
.swiftpm/
.swift-module-cache/
*.xcodeproj/
*.app
*.icns
*.iconset/
*.dmg

# Local only: old backups, test screenshots, scratch
v1/
test-shots/

.DS_Store
!Resources/dmg/DS_Store

# Compiled test helpers (build from tools/*.swift)
tools/*
!tools/*.swift
!tools/README.md
!tools/copilot-eval.py
!tools/copilot-audio-fixture.py
!tools/coach-reading-fixtures.py
!tools/qwen-realtime-fixture.py
!tools/test_deepseek_latency.py
!tools/plain-english-check.py
!tools/copilot-questions.json
!tools/copilot-prompt.json
!tools/copilot-interview-background.json
!tools/macos-vm/
!tools/audio-probe/

# Windows: build output, spike results and clips (windows/spike/make-clips.sh, ming_asr.py)
windows/**/bin/
windows/**/obj/
windows/spike/out/
windows/spike/clips/*.wav

# Share server: local state and secrets (server/.dev.vars holds the ZenMux key for wrangler dev)
server/.wrangler/
server/.dev.vars

# Signing keys never enter the repo (android/scripts/keystore.sh keeps them in ~/.cicada-android)
*.jks
*.keystore

# The Apple Watch project is source; keep personal pairing and user data ignored.
!watch/CicadaWatch.xcodeproj/
!watch/CicadaWatch.xcodeproj/**
watch/CicadaWatch.xcodeproj/**/xcuserdata/
